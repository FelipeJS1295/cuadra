# ---------------------------------------------------------------------------
# Cuadra · configuración local (copia este archivo como .env)
# ---------------------------------------------------------------------------

# Postgres en Docker (docker compose up -d). Puerto propio para no chocar con otros.
POSTGRES_PORT=5450
POSTGRES_USER=cuadra
POSTGRES_PASSWORD=cuadra
POSTGRES_DB=cuadra
DATABASE_URL=postgres://cuadra:cuadra@localhost:5450/cuadra

# API (NestJS) y web (Next.js)
API_PORT=4200
WEB_ORIGIN=http://localhost:3200
NEXT_PUBLIC_API_URL=http://localhost:4200/api

# Firma de sesiones y llave para cifrar las claves de cada empresa (SII, retailers).
# Cámbiala por una frase larga y NO la cambies después (se perderían las claves guardadas).
AUTH_SECRET=cambia-esto-por-una-frase-larga-y-secreta
SESSION_DAYS=7
COOKIE_SECURE=false

# Administrador del sistema (se crea solo la primera vez que parte la API)
SUPERADMIN_EMAIL=admin@cuadra.local
SUPERADMIN_PASSWORD=admin12345
